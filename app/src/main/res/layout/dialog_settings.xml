<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <EditText android:id="@+id/et_url" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="@string/api_url"
        android:inputType="textUri" android:textDirection="ltr" />
    <EditText android:id="@+id/et_key" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="@string/api_key"
        android:inputType="textPassword" android:textDirection="ltr" />
    <EditText android:id="@+id/et_model" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="@string/model"
        android:inputType="text" android:textDirection="ltr" />
</LinearLayout>
